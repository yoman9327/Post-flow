# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Facebook (also configurable later from the admin dashboard under Settings)
FB_GRAPH_API_VERSION=v21.0

# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# First-run bootstrap passwords. Once you log in you can change both from the
# admin dashboard (Settings tab) — after that, these env vars are ignored.
ADMIN_PASSWORD=
UPLOAD_PASSWORD=
